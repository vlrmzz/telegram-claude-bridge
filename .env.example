# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Comma-separated Telegram user IDs allowed to use the bot (required —
# the bridge refuses to start without it). Get your ID from @userinfobot.
ALLOWED_USERS=123456789

# Claude model to use (sonnet, opus, haiku)
CLAUDE_MODEL=sonnet

# Seconds before a Claude run is killed
CLAUDE_TIMEOUT=300

# Full path to the claude CLI binary.
# Find it with: which claude
# Common locations:
#   macOS (nvm):  /Users/you/.nvm/versions/node/v22.x.x/bin/claude
#   macOS (brew): /opt/homebrew/bin/claude
# setup.sh will try to detect this automatically.
CLAUDE_PATH=/usr/local/bin/claude

# Whisper model for voice transcription (base, small, medium, large)
WHISPER_MODEL=base

# Directory holding your projects: each subdirectory with an AGENTS.md is a
# project you can route a chat or forum topic to. Captures are saved under
# $PROJECTS_DIR/captures/.
PROJECTS_DIR=~/resources

# Voice for spoken replies (/voice on). Any edge-tts voice, e.g. it-IT-DiegoNeural
TTS_VOICE=en-US-GuyNeural

# OpenRouter API key — used by /search (Perplexity Sonar). Optional.
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=
