# Main bridge bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Baby tracker bot token — separate bot, optional
BABY_BOT_TOKEN=your-baby-bot-token

# Comma-separated Telegram user IDs allowed to use the main bridge
# Get your ID from @userinfobot
ALLOWED_USERS=123456789

# Comma-separated Telegram user IDs allowed to use the baby bot
BABY_ALLOWED_USERS=123456789,987654321

# Whisper model for voice transcription (base, small, medium, large)
WHISPER_MODEL=base

# Claude model to use (sonnet, opus, haiku)
CLAUDE_MODEL=sonnet

# Seconds before Claude times out
CLAUDE_TIMEOUT=300

# Full path to the claude CLI binary.
# Find it with: which claude
# Common locations:
#   macOS (nvm):  /Users/you/.nvm/versions/node/v22.x.x/bin/claude
#   macOS (brew): /opt/homebrew/bin/claude
# setup.sh will try to detect this automatically.
CLAUDE_PATH=/usr/local/bin/claude

# OpenRouter API key — used for Perplexity web search (optional)
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=
